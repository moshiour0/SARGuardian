# Data — never commit satellite products
data/nisar_l2/*
data/dem/*
data/slc/*
!data/**/.gitkeep
*.h5
*.zip
*.SAFE/
*.tif
*.tiff

# Outputs
outputs/*
!outputs/.gitkeep

# ...except the derived measurements. These are a few kilobytes each and
# they are the scientific result: every statistic, time series and noise
# floor the analysis rests on. Regenerating one means re-downloading a
# gigabyte per pair, so they belong in version control even though the
# products they came from never can.
!outputs/*stats*.csv
!outputs/ts_*.csv
!outputs/detectability.csv
# Same reasoning for the impoundment maps: 13 KB each, and regenerating one
# means several thousand external DEM queries.
!outputs/dam_sites_*.geojson
*.png
*.csv

# Secrets
.env
.netrc
_netrc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

review/
